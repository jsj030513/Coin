# Spring Boot environment variables. Never put exchange API keys in this file.
# Optional: Base64 encoded 32-byte AES key. If omitted, a local key is generated under data/.
# ACCOUNT_ENCRYPTION_KEY=
MIN_QUOTE_VOLUME_24H=1000000000
FEE_PERCENT=0.1
MIN_PROFIT_PERCENT=0.3
MAX_PROFIT_PERCENT=20.0
ORDER_AMOUNT_KRW=5000
MAX_ORDER_AMOUNT_KRW=50000
DAILY_MAX_LOSS_KRW=10000
MAX_CONCURRENT_POSITIONS=3
INITIAL_BALANCE_KRW=100000
INITIAL_ASSET_BALANCE=100
INITIAL_SEED_ASSET_COUNT=10
SERVER_ADDRESS=0.0.0.0
ENABLED_EXCHANGES=upbit,bithumb
MIN_EXPECTED_PROFIT_KRW=100
UPBIT_FEE_PERCENT=0.05
BITHUMB_FEE_PERCENT=0.25
COINONE_FEE_PERCENT=0.02
# 코빗 기본 플랜이면 0.10, 무료 플랜이면 0.20
KORBIT_FEE_PERCENT=0.20
SCAN_ENABLED=true
SCAN_INTERVAL_MS=3000
REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=3
OPPORTUNITY_COOLDOWN_SECONDS=60
SERVER_PORT=8080
LIVE_MAX_ORDER_KRW=12000
LIVE_INVENTORY_DUST_FLOOR_KRW=6000
LIVE_INVENTORY_MAX_IMBALANCE_PERCENT=40
LIVE_INVENTORY_REBALANCE_MAX_COST_PERCENT=2.0
LIVE_CYCLE_TIMEOUT_SECONDS=120

# Telegram alert automation. Put real values only in your local .env, never in git.
TELEGRAM_ENABLED=false
TELEGRAM_OPPORTUNITY_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_PROFIT_PERCENT=0.3
TELEGRAM_MIN_EXPECTED_PROFIT_KRW=100
TELEGRAM_TOP_N=3
TELEGRAM_COOLDOWN_SECONDS=300
TELEGRAM_REBALANCE_ENABLED=true
TELEGRAM_REBALANCE_CHECK_INTERVAL_MS=60000
TELEGRAM_REBALANCE_MAX_SINGLE_EXCHANGE_KRW_RATIO_PERCENT=75
TELEGRAM_REBALANCE_MIN_TRANSFER_KRW=30000
TELEGRAM_REBALANCE_TRANSFER_ROUND_KRW=1000
TELEGRAM_AUTO_PORTFOLIO_SUMMARY_INTERVAL_MS=300000
TELEGRAM_AUTO_PORTFOLIO_SUMMARY_INITIAL_DELAY_MS=60000
TELEGRAM_DAILY_PROFIT_CRON=0 50 23 * * *
TELEGRAM_DAILY_PROFIT_ZONE=Asia/Seoul

# PostgreSQL profile only
# SPRING_PROFILES_ACTIVE=postgres
# DATABASE_URL=jdbc:postgresql://localhost:5432/arbitrage
# DATABASE_USERNAME=arbitrage
# DATABASE_PASSWORD=change-me
